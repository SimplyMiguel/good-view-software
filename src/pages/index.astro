---
import Layout from "../layouts/Layout.astro";
import { site } from "../config";

const email = site.email?.trim();
const mailto = email
  ? `mailto:${email}?subject=${encodeURIComponent("Project inquiry")}`
  : undefined;

const services = [
  {
    title: "Websites",
    body: "Fast, mobile-friendly websites that explain your business and help customers contact you.",
  },
  {
    title: "Business tools",
    body: "Custom dashboards, invoice tools, client portals, and systems for managing daily work.",
  },
  {
    title: "Integrations and automation",
    body: "Connect existing tools and reduce repetitive data entry and reporting.",
  },
];
---

<Layout
  title={`${site.name} · Custom websites and software`}
  description="Independent software developer in Bakersfield, California, building practical websites, dashboards, and custom tools for small businesses and nonprofits."
>
  <header class="border-b border-line">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-5 sm:px-8">
      <a href="/" class="whitespace-nowrap text-sm font-semibold tracking-tight sm:text-base">
        {site.name}
      </a>
      <nav aria-label="Main" class="flex items-center gap-x-4 text-[13px] text-ink-700 sm:gap-x-7 sm:text-sm">
        <a href="#services" class="hover:text-ink-950 hover:underline underline-offset-4">Services</a>
        <a href="#about" class="hover:text-ink-950 hover:underline underline-offset-4">About</a>
        <a href="#contact" class="hover:text-ink-950 hover:underline underline-offset-4">Contact</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="mx-auto max-w-5xl px-5 pb-16 pt-16 sm:px-8 sm:pb-24 sm:pt-28">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-brand">
        Independent software developer
      </p>
      <h1 class="mt-6 max-w-4xl font-display text-5xl leading-[1.02] tracking-tight sm:text-6xl lg:text-7xl">
        Custom websites and software for your business.
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-700">
        I help businesses and nonprofits replace manual work with practical websites, dashboards, and custom tools. Based in Bakersfield, California.
      </p>
      <a
        href="#contact"
        class="mt-10 inline-flex items-center justify-center rounded-full bg-brand px-7 py-3.5 text-sm font-medium text-white hover:bg-brand-dark"
      >
        Discuss your project
      </a>
    </section>

    <section id="services" class="border-t border-line">
      <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-24">
        <h2 class="font-display text-4xl tracking-tight sm:text-5xl">What I build</h2>
        <div class="mt-12 grid gap-10 sm:grid-cols-3 sm:gap-8">
          {
            services.map((service) => (
              <article class="border-t border-line pt-6">
                <h3 class="text-base font-semibold tracking-tight">{service.title}</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-ink-700">{service.body}</p>
              </article>
            ))
          }
        </div>

        <p class="mt-14 max-w-2xl border-l-2 border-brand pl-5 text-[15px] leading-relaxed text-ink-700">
          <span class="font-semibold text-ink-950">Pricing.</span>{" "}
          Every project starts with a conversation and a written quote. Scope and pricing are agreed before development begins.
        </p>
      </div>
    </section>

    <section id="about" class="border-t border-line bg-white">
      <div class="mx-auto grid max-w-5xl gap-8 px-5 py-16 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] sm:gap-16 sm:px-8 sm:py-24">
        <h2 class="font-display text-4xl tracking-tight sm:text-5xl">About</h2>
        <div class="max-w-xl space-y-5 text-[16px] leading-relaxed text-ink-700">
          <p>
            I'm an independent developer based in Bakersfield. I build websites and business software for small businesses and nonprofits, and I do the work myself.
          </p>
          <p>
            That means you work directly with the person designing, building, and supporting your project. No account managers, no handoffs, and no team you never meet.
          </p>
          <p>
            I care about software that earns its place: it should remove a repetitive task, make information easier to find, or help customers reach you. If it doesn't do one of those things, it probably doesn't need to be built.
          </p>
        </div>
      </div>
    </section>

    <section id="contact" class="border-t border-line">
      <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-24">
        <h2 class="font-display text-4xl tracking-tight sm:text-5xl">Tell me what you need.</h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-700">
          Describe your business, what you want to build, and what's difficult about your current process. Not sure what you need? That's fine too.
        </p>

        {
          email ? (
            <div class="mt-9">
              <a
                href={mailto}
                class="inline-flex items-center justify-center rounded-full bg-brand px-7 py-3.5 text-sm font-medium text-white hover:bg-brand-dark"
              >
                Email about a project
              </a>
              <p class="mt-4 text-sm text-ink-500">
                Or write to <a href={mailto} class="text-ink-700 underline underline-offset-4">{email}</a>.
              </p>
            </div>
          ) : (
            <p class="mt-9 text-[15px] font-medium text-ink-700">
              {site.inquiriesNote}
            </p>
          )
        }
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto max-w-5xl space-y-1 px-5 py-8 text-sm text-ink-500 sm:px-8">
      <p>{site.name} · {site.location}</p>
      <p>Operated by {site.operator}.</p>
    </div>
  </footer>
</Layout>