---
import Layout from "../layouts/Layout.astro";
import ProjectWheel from "../components/ProjectWheel.astro";
import ServiceArt from "../components/ServiceArt.astro";
import { site } from "../config";

const email = site.email?.trim();
const mailto = email
  ? `mailto:${email}?subject=${encodeURIComponent("Project inquiry")}`
  : undefined;

const services = [
  {
    number: "001",
    kind: "website" as const,
    title: "Websites",
    body: "Fast, mobile-friendly websites that explain your business and help customers contact you.",
  },
  {
    number: "002",
    kind: "viewer" as const,
    title: "3D viewers",
    body: "Interactive product views customers can rotate, configure, and inspect in the browser.",
  },
  {
    number: "003",
    kind: "mobile" as const,
    title: "Mobile apps",
    body: "iOS and Android apps for booking, ordering, or work out in the field.",
  },
  {
    number: "004",
    kind: "tools" as const,
    title: "Internal tools",
    body: "Custom dashboards and invoicing tools for managing daily work.",
  },
];
---

<Layout
  title={`${site.name} · Custom websites and software`}
  description="Independent software developer in Bakersfield, California, building practical websites, dashboards, and custom tools for small businesses and nonprofits."
>
  <header>
    <div class="mx-auto grid max-w-[1080px] grid-cols-2 items-center gap-4 px-6 py-5 sm:grid-cols-3 sm:px-10">
      <a href="/" class="whitespace-nowrap text-[11px] font-medium uppercase tracking-[0.08em] sm:text-[12px]">
        {site.name}
      </a>
      <p class="hidden text-center font-mono text-[9px] uppercase tracking-[0.12em] text-ink-500 sm:block sm:text-[10px]">
        Bakersfield, California
      </p>
      <nav
        aria-label="Main"
        class="flex items-center justify-self-end gap-x-4 font-mono text-[9px] uppercase tracking-[0.12em] text-ink-700 sm:gap-x-7 sm:text-[10px]"
      >
        <a href="#services" class="hover:text-ink-950">Services</a>
        <a href="#about" class="hover:text-ink-950">About</a>
        <a href="#contact" class="hover:text-ink-950">Contact</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section><div class="mx-auto max-w-[1080px] px-6 pb-16 pt-10 sm:px-10 sm:pb-24 sm:pt-16">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
        <h1 class="max-w-[14ch] text-[clamp(2.9rem,7.6vw,5.3rem)] font-normal leading-[0.98] tracking-[-0.025em] lg:col-span-7">
          Custom websites and software for your business.
        </h1>
        <div class="lg:col-span-5 lg:pl-4 lg:pt-1">
          <p class="max-w-[29ch] text-[13px] leading-[1.6] text-ink-700 sm:text-[14px]">
            I help businesses and nonprofits replace manual work with practical websites, dashboards, and custom tools. Based in Bakersfield, California.
          </p>
          <a
            href="#contact"
            class="mt-10 inline-flex items-center gap-4 rounded-full border border-ink-950 py-1 pl-5 pr-1 text-[12px] font-medium hover:bg-ink-950 hover:text-paper sm:mt-14"
          >
            Discuss your project
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-ink-950 text-[13px] text-paper" aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
      </div>
    </div></section>

    <section id="services">
      <div class="mx-auto max-w-[1080px] px-6 pt-10 sm:px-10 sm:pt-14">
        <div class="flex items-end justify-between pb-3">
          <p class="font-mono text-[9px] uppercase tracking-[0.14em] text-ink-500 sm:text-[10px]">Services</p>
          <p class="font-mono text-[9px] uppercase tracking-[0.14em] text-ink-500 sm:text-[10px]">001—004</p>
        </div>

        <div class="grid gap-y-10 py-8 sm:grid-cols-2 sm:gap-y-12 lg:grid-cols-4 lg:gap-y-0 sm:py-9">
          {
            services.map((service, index) => (
              <article
                class:list={[
                  "flex flex-col",
                  index === 0 ? "lg:pr-6" : "lg:border-l lg:border-line lg:px-6",
                  index === 3 ? "lg:pr-0" : "",
                ]}
              >
                <span class="font-mono text-[9px] tracking-[0.12em] text-ink-500">{service.number}</span>
                <div class="mt-8 flex h-[96px] items-start text-ink-950">
                  <ServiceArt kind={service.kind} />
                </div>
                <h2 class="mt-7 text-[16px] font-normal leading-tight tracking-[-0.01em]">{service.title}</h2>
                <p class="mt-2 max-w-[30ch] text-[11px] leading-[1.55] text-ink-700">{service.body}</p>
              </article>
            ))
          }
        </div>

        <div class="grid gap-2 border-t border-line py-4 sm:grid-cols-3 sm:gap-8">
          <p class="font-mono text-[9px] uppercase tracking-[0.14em] text-ink-500 sm:text-[10px]">Pricing</p>
          <p class="text-[11.5px] leading-[1.55] text-ink-700 sm:col-span-2 sm:max-w-[52ch]">
            Every project starts with a conversation and a written quote. Scope and pricing are agreed before development begins.
          </p>
        </div>
      </div>
    </section>

    <ProjectWheel />

    <section id="about" class="bg-[#efefea]">
      <div class="mx-auto max-w-[1080px] px-6 py-16 sm:px-10 sm:py-24">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
          <div class="lg:col-span-7">
            <p class="font-mono text-[9px] uppercase tracking-[0.14em] text-ink-500 sm:text-[10px]">About</p>
            <h2 class="mt-5 max-w-[13ch] text-[clamp(2.2rem,4.4vw,3.4rem)] font-normal leading-[1.02] tracking-[-0.03em]">
              Built by the person you hire.
            </h2>
          </div>
          <div class="max-w-[46ch] space-y-4 self-end text-[14px] leading-[1.55] text-ink-700 sm:text-[15px] lg:col-span-5">
            <p>
              I'm an independent developer based in Bakersfield. I build websites and business software for small businesses and nonprofits, and I do the work myself.
            </p>
            <p>
              You work directly with the person designing, building, and supporting your project. No account managers, no handoffs, no team you never meet.
            </p>
            <p>
              I care about software that earns its place: it should remove a repetitive task, make information easier to find, or help customers reach you.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="mx-auto mt-20 max-w-[1080px] px-6 sm:mt-28 sm:px-10">
        <div class="border-t border-line pt-4">
          <p class="font-mono text-[9px] uppercase tracking-[0.14em] text-ink-500 sm:text-[10px]">Contact</p>
          <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-8">
            <h2 class="max-w-[11ch] text-[clamp(2.5rem,6vw,4.4rem)] font-normal leading-[0.98] tracking-[-0.025em] lg:col-span-7">
              Tell me what you need.
            </h2>
            <div class="max-w-[32ch] lg:col-span-5 lg:pt-1">
              <p class="text-[13px] leading-[1.6] text-ink-700 sm:text-[14px]">
                Describe your business, what you want to build, and what's difficult about your current process. Not sure what you need? That's fine too.
              </p>

              {
                email ? (
                  <div class="mt-10">
                    <a
                      href={mailto}
                      class="inline-flex items-center gap-4 rounded-full border border-ink-950 py-1 pl-5 pr-1 text-[12px] font-medium hover:bg-ink-950 hover:text-paper"
                    >
                      Email about a project
                      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-ink-950 text-[13px] text-paper" aria-hidden="true">
                        ↗
                      </span>
                    </a>
                    <p class="mt-4 text-[12px] text-ink-500">
                      Or write to <a href={mailto} class="text-ink-700 underline underline-offset-4">{email}</a>.
                    </p>
                  </div>
                ) : (
                  <p class="mt-10 font-mono text-[9px] uppercase tracking-[0.12em] text-ink-700 sm:text-[10px]">
                    {site.inquiriesNote}
                  </p>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="mt-20 border-t border-line sm:mt-24">
    <div class="mx-auto flex max-w-[1080px] flex-col gap-2 px-6 py-6 font-mono text-[9px] uppercase tracking-[0.1em] text-ink-500 sm:flex-row sm:items-center sm:justify-between sm:px-10 sm:text-[10px]">
      <p>{site.name} · {site.location}</p>
      <p>Operated by {site.operator}.</p>
    </div>
  </footer>
</Layout>