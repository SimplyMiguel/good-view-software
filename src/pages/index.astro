---
import Layout from "../layouts/Layout.astro";
import ProjectWheel from "../components/ProjectWheel.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import ServiceArt from "../components/ServiceArt.astro";
import { site } from "../config";

const email = site.email?.trim();
const mailto = email
  ? `mailto:${email}?subject=${encodeURIComponent("Project inquiry")}`
  : undefined;

const services = [
  {
    number: "01",
    kind: "website" as const,
    title: "Websites",
    body: "Fast, mobile-friendly sites that explain what you do and make it easy for customers to contact you.",
  },
  {
    number: "02",
    kind: "viewer" as const,
    title: "3D viewers",
    body: "Interactive product views customers can rotate, configure, and inspect in the browser.",
  },
  {
    number: "03",
    kind: "mobile" as const,
    title: "Mobile apps",
    body: "iOS and Android apps for booking, ordering, or work out in the field.",
  },
  {
    number: "04",
    kind: "tools" as const,
    title: "Internal tools",
    body: "Custom dashboards and invoicing tools that replace manual spreadsheets.",
  },
];

const reasons = [
  {
    number: "01",
    title: "One person, start to finish",
    body: "The person who scopes the work designs it, writes the code and supports it afterwards. Nothing is lost in a hand-off.",
  },
  {
    number: "02",
    title: "Written scope before code",
    body: "You get a plain-language scope and a price before development starts. Nothing is billed before you approve it.",
  },
  {
    number: "03",
    title: "Working software early",
    body: "A preview link every week or two, not a big reveal months later. You can use it and react to it as it is built.",
  },
  {
    number: "04",
    title: "Built to be handed over",
    body: "Code, accounts and documentation are in your name, so the software stays yours if we stop working together.",
  },
  {
    number: "05",
    title: "No idea too small",
    body: "From one spreadsheet that eats an afternoon to the system the business runs on, the job is to find the version that works.",
  },
];
---

<Layout
  title={`${site.name} · Custom websites and software`}
  description="Independent software developer in Bakersfield, California, building practical websites, dashboards, and custom tools for small businesses and nonprofits."
>
  <header class="sticky top-0 z-40 border-b border-line/80 bg-paper/85 backdrop-blur-md">
    <div class="mx-auto flex h-16 w-full max-w-[1240px] items-center justify-between gap-6 px-5 sm:px-8">
      <a href="/" class="flex items-center gap-2">
        <span class="grid h-7 w-7 place-items-center rounded-md bg-brand text-[13px] font-extrabold text-white" aria-hidden="true">G</span>
        <span class="text-[15px] font-semibold tracking-[-0.02em]">{site.name}</span>
      </a>
      <nav aria-label="Main" class="hidden items-center gap-7 text-[14px] font-medium text-ink-700 md:flex">
        <a href="#services" class="transition-colors hover:text-ink-950">Services</a>
        <a href="#work" class="transition-colors hover:text-ink-950">Work</a>
        <a href="#about" class="transition-colors hover:text-ink-950">About</a>
        <a href="#contact" class="transition-colors hover:text-ink-950">Contact</a>
      </nav>
      <a
        href="#contact"
        class="inline-flex h-10 items-center gap-2 rounded-[8px] bg-brand px-4 text-[14px] font-semibold text-white transition-colors hover:bg-brand-2"
      >
        Start a project
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </header>

  <main id="main">
    <!-- Hero: heavy headline on the left, brand plane and live preview on the right -->
    <section class="relative overflow-hidden">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute right-0 top-0 hidden h-full w-[52%] bg-brand md:block"
        style="clip-path: polygon(160px 0, 100% 0, 100% 100%, 160px 100%, 0 50%)"
      >
      </div>

      <div class="relative mx-auto grid w-full max-w-[1240px] items-center gap-12 px-5 py-14 sm:px-8 md:min-h-[600px] md:grid-cols-12 md:gap-6 md:py-20">
        <div class="md:col-span-6 lg:col-span-6">
          <h1 class="max-w-[13ch] text-[clamp(2.6rem,4.6vw,3.9rem)] leading-[1.02] tracking-[-0.045em]">
            Websites and software your business runs on.
          </h1>
          <p class="mt-6 max-w-[46ch] text-[17px] leading-[1.6] text-ink-500 sm:text-[18px]">
            Good View builds the site customers find you through and the tools your team uses every day. One developer in Bakersfield, California — from first sketch to long-term support.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a href="#contact" class="inline-flex h-[46px] items-center gap-2 rounded-[8px] bg-brand px-5 text-[15px] font-semibold text-white transition-colors hover:bg-brand-2">
              Start a project
              <span aria-hidden="true">→</span>
            </a>
            <a href="#work" class="inline-flex h-[46px] items-center gap-2 rounded-[8px] border border-line-strong px-5 text-[15px] font-semibold text-ink-950 transition-colors hover:bg-paper-soft">
              See the work
              <span aria-hidden="true">→</span>
            </a>
          </div>
          <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-300">
            Websites · Mobile apps · Internal tools
          </p>
        </div>

        <div class="relative md:col-span-6 md:pl-8">
          <div class="overflow-hidden rounded-[16px] border border-line bg-white shadow-[0_24px_60px_-24px_rgba(10,12,30,0.28)]">
            <div class="flex h-9 items-center gap-1.5 border-b border-line bg-paper-soft px-3">
              <span class="h-2 w-2 rounded-full bg-line-strong"></span>
              <span class="h-2 w-2 rounded-full bg-line-strong"></span>
              <span class="h-2 w-2 rounded-full bg-line-strong"></span>
              <span class="ml-2 truncate font-mono text-[10px] text-ink-300">etxea.example</span>
            </div>
            <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
              <span class="text-[11px] font-semibold uppercase tracking-[0.08em]">Etxea</span>
              <span class="flex gap-3 font-mono text-[9px] uppercase tracking-[0.1em] text-ink-500">
                <span>Menu</span><span class="hidden sm:inline">Visit</span><span>Book</span>
              </span>
            </div>
            <div class="relative">
              <img src="/demos/restaurant/room.jpg" alt="Etxea restaurant site concept: hero photograph behind the restaurant name and booking link" class="aspect-[16/11] w-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/10 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-4 text-white">
                <p class="text-[22px] font-semibold leading-none tracking-[-0.03em]">Basque bar &amp; table</p>
                <p class="mt-1.5 text-[11px] text-white/80">Downtown Bakersfield · open Thursday to Sunday</p>
              </div>
            </div>
          </div>

          <div class="absolute -bottom-10 -right-2 hidden sm:-right-6 sm:block">
            <PhoneFrame width="128px" label="Ridgeline Electric field app: three jobs today, first is a panel upgrade at nine">
              <div class="flex h-full flex-col">
                <div class="flex items-center justify-between px-3 pb-1.5 pt-4">
                  <span class="font-mono text-[9px] text-ink-500">9:41</span>
                  <span class="font-mono text-[9px] text-ink-500">100%</span>
                </div>
                <div class="flex-1 px-3">
                  <p class="font-mono text-[8px] uppercase tracking-[0.12em] text-ink-500">Ridgeline Electric</p>
                  <p class="mt-2 text-[15px] font-semibold leading-[1.05] tracking-[-0.03em]">Today's jobs</p>
                  <div class="mt-3 space-y-1.5">
                    <div class="rounded-md bg-ink-950 px-2 py-1.5 text-white">
                      <p class="text-[9px] font-semibold">Panel upgrade</p>
                      <p class="font-mono text-[8px] text-white/60">9:00 · 1042</p>
                    </div>
                    <div class="rounded-md border border-line px-2 py-1.5">
                      <p class="text-[9px] font-semibold">EV charger</p>
                      <p class="font-mono text-[8px] text-ink-500">11:30 · 1043</p>
                    </div>
                    <div class="rounded-md border border-line px-2 py-1.5">
                      <p class="text-[9px] font-semibold">Inspection</p>
                      <p class="font-mono text-[8px] text-ink-500">14:00 · 1044</p>
                    </div>
                  </div>
                </div>
                <p class="border-t border-line px-3 py-2 font-mono text-[8px] uppercase tracking-[0.1em] text-ink-500">3 jobs today</p>
              </div>
            </PhoneFrame>
          </div>
        </div>
      </div>
    </section>

    <!-- What we build -->
    <section id="services" class="border-t border-line">
      <div class="mx-auto w-full max-w-[1240px] px-5 py-16 sm:px-8 sm:py-24">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="max-w-[18ch] text-[clamp(1.75rem,3vw,2.5rem)]">What we build</h2>
          <p class="max-w-[38ch] text-[15px] leading-[1.6] text-ink-500">
            Four things, done properly — a site that brings in enquiries, an app that saves a trip, a tool that ends the spreadsheet.
          </p>
        </div>

        <div class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
          {
            services.map((service) => (
              <article class="flex h-full flex-col rounded-[16px] border border-line bg-paper-soft p-5 transition-colors hover:border-line-strong">
                <div class="flex h-20 items-center text-ink-950 sm:h-[96px]">
                  <ServiceArt kind={service.kind} />
                </div>
                <div class="mt-6 flex items-baseline gap-3 border-t border-line pt-4">
                  <span class="font-mono text-[11px] tracking-[0.1em] text-brand-text">{service.number}</span>
                  <h3 class="text-[18px] font-semibold tracking-[-0.02em]">{service.title}</h3>
                </div>
                <p class="mt-2 max-w-[30ch] text-[14px] leading-[1.6] text-ink-500">{service.body}</p>
              </article>
            ))
          }
        </div>

        <div class="mt-14 grid gap-2 rounded-[16px] bg-brand-tint px-6 py-5 sm:grid-cols-3 sm:gap-6">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-brand-text">Pricing</p>
          <p class="text-[14px] leading-[1.6] text-ink-700 sm:col-span-2 sm:max-w-[62ch]">
            Every project starts with a conversation and a written quote. Scope and pricing are agreed before development begins, and nothing is billed before you approve it.
          </p>
        </div>
      </div>
    </section>

    <!-- Work -->
    <section id="work" class="border-t border-line bg-paper-soft">
      <div class="mx-auto w-full max-w-[1240px] px-5 py-16 sm:px-8 sm:py-24">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="max-w-[18ch] text-[clamp(1.75rem,3vw,2.5rem)]">Recent work</h2>
          <p class="max-w-[38ch] text-[15px] leading-[1.6] text-ink-500">
            Concept previews, not client work — pick a project on the right to see the kind of thing each one stands for.
          </p>
        </div>

        <ProjectWheel />
      </div>
    </section>

    <!-- Why clients work with us -->
    <section id="why" class="border-t border-line">
      <div class="mx-auto w-full max-w-[1240px] px-5 py-16 sm:px-8 sm:py-24">
        <h2 class="max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">Why clients work with us</h2>
        <ol class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {
            reasons.map((reason) => (
              <li class="border-t border-line pt-4">
                <span class="font-mono text-[11px] tracking-[0.1em] text-brand-text">{reason.number}</span>
                <h3 class="mt-3 text-[16px] font-semibold tracking-[-0.02em]">{reason.title}</h3>
                <p class="mt-2 text-[14px] leading-[1.6] text-ink-500">{reason.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="border-t border-line bg-paper-soft">
      <div class="mx-auto grid w-full max-w-[1240px] gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-12 lg:gap-6">
        <div class="lg:col-span-6">
          <h2 class="max-w-[16ch] text-[clamp(1.75rem,3vw,2.5rem)]">Built by the person you hire.</h2>
        </div>
        <div class="max-w-[54ch] space-y-4 text-[16px] leading-[1.65] text-ink-700 lg:col-span-6">
          <p>
            I'm an independent developer based in Bakersfield. I build websites and business software for small businesses and nonprofits, and I do the work myself.
          </p>
          <p>
            You work directly with the person designing, building, and supporting your project. No account managers, no hand-offs, no team you never meet.
          </p>
          <p>
            I care about software that earns its place: it should remove a repetitive task, make information easier to find, or help customers reach you.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="bg-brand text-white">
      <div class="mx-auto w-full max-w-[1240px] px-5 py-16 sm:px-8 sm:py-24">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-6">
          <h2 class="max-w-[14ch] text-[clamp(2rem,4vw,3.2rem)] text-white lg:col-span-6">Tell me what you need.</h2>
          <div class="max-w-[42ch] lg:col-span-6 lg:pt-2">
            <p class="text-[16px] leading-[1.65] text-white/85">
              Describe your business, what you want to build, and what's difficult about your current process. Not sure what you need? That's fine too.
            </p>
            {
              email ? (
                <div class="mt-8">
                  <a
                    href={mailto}
                    class="inline-flex h-[46px] items-center gap-2 rounded-[8px] bg-white px-5 text-[15px] font-semibold text-brand-text transition-colors hover:bg-brand-tint"
                  >
                    Email about a project
                    <span aria-hidden="true">→</span>
                  </a>
                  <p class="mt-5 text-[14px] text-white/75">
                    Or write to <a href={mailto} class="underline underline-offset-4">{email}</a>.
                  </p>
                </div>
              ) : (
                <p class="mt-8 inline-flex items-center gap-2 rounded-[8px] bg-white px-4 py-3 font-mono text-[12px] uppercase tracking-[0.12em] text-brand-text">
                  {site.inquiriesNote}
                </p>
              )
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex w-full max-w-[1240px] flex-col gap-2 px-5 py-7 text-[13px] text-ink-500 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <p>{site.name} · {site.location}</p>
      <p>Operated by {site.operator}.</p>
    </div>
  </footer>
</Layout>