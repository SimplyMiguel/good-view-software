---
import Layout from "../layouts/Layout.astro";
import ProjectWheel from "../components/ProjectWheel.astro";
import Walker from "../components/Walker.astro";
import PixelIcon from "../components/PixelIcon.astro";
import type { PixelIconName } from "../components/pixelIcons";
import { site } from "../config";

const email = site.email?.trim();

const services: { number: string; icon: PixelIconName; title: string; body: string; example?: string }[] = [
  {
    number: "01",
    icon: "website",
    title: "Websites",
    body: "Fast, mobile-friendly sites that explain what you do and make it easy for customers to contact you.",
    example: "See a restaurant site",
  },
  {
    number: "02",
    icon: "viewer",
    title: "3D viewers",
    body: "Interactive product views customers can rotate, configure, and inspect in the browser.",
  },
  {
    number: "03",
    icon: "mobile",
    title: "Mobile apps",
    body: "iOS and Android apps for booking, ordering, or work out in the field.",
    example: "See a booking app",
  },
  {
    number: "04",
    icon: "tools",
    title: "Internal tools",
    body: "Custom dashboards and invoicing tools that replace manual spreadsheets.",
    example: "See a dashboard",
  },
];

const steps = [
  { title: "Talk", body: "A short conversation about your business, who will use the software, and what is painful today." },
  { title: "Scope", body: "A written scope and a price: what gets built first, what it costs, and what is left out on purpose." },
  { title: "Build", body: "Working software on a preview link every week or two, so you see progress instead of waiting for a reveal." },
  { title: "Support", body: "Code, accounts and documentation are in your name, and I stay on to maintain what I built." },
];

const reasons = [
  { title: "One person, start to finish", body: "The person who scopes the work designs it, writes the code and supports it afterwards. Nothing is lost in a hand-off." },
  { title: "Written scope before code", body: "You get a plain-language scope and a price before development starts. Nothing is billed before you approve it." },
  { title: "Working software early", body: "A preview link every week or two, not a big reveal months later. You can use it and react to it as it is built." },
  { title: "Built to be handed over", body: "Code, accounts and documentation are in your name, so the software stays yours if we stop working together." },
];

const faqs = [
  {
    q: "How does a project start?",
    a: "With a conversation. After that you get a written scope and a quote. Scope and pricing are agreed before development begins, and nothing is billed before you approve it.",
  },
  {
    q: "I'm not sure what I need. Is that a problem?",
    a: "No. Describe your business and what is difficult about your current process, and we will work out the smallest version that helps. Sometimes the answer is a tool you already pay for.",
  },
  {
    q: "Is any project too small?",
    a: "No. One spreadsheet that eats an afternoon, one fragile report, or a fix to an existing site is a fine place to start.",
  },
  {
    q: "Who will I be working with?",
    a: "Me, directly. I design, build and support every project myself, so there are no account managers or hand-offs.",
  },
  {
    q: "Who owns the finished software?",
    a: "You do. Code, accounts and documentation are set up in your name, so the software stays yours even if we stop working together.",
  },
  {
    q: "What happens after launch?",
    a: "I stay on to look after what I built, with fixes and updates as you need them, so you are not left with something nobody understands.",
  },
];

const needs = ["Website", "3D viewer", "Mobile app", "Internal tool", "Not sure yet"];
const timelines = ["As soon as possible", "This quarter", "Just exploring"];

const navLinks = [
  { href: "#services", label: "Services" },
  { href: "#work", label: "Work" },
  { href: "#process", label: "Process" },
  { href: "#faq", label: "FAQ" },
];
---

<Layout
  title={`${site.name} · Custom websites and software`}
  description="Independent software developer in Bakersfield, California, building practical websites, dashboards, and custom tools for small businesses and nonprofits."
>
  <header data-site-header class="site-header fixed inset-x-0 top-0 z-50">
    <div class="mx-auto flex h-16 w-full max-w-[1280px] items-center justify-between gap-4 px-5 sm:px-8">
      <a href="/" class="flex items-center gap-3" aria-label={`${site.name} home`}>
        <PixelIcon name="mark" class="h-7 w-7" />
        <span class="font-display text-[22px] leading-none tracking-[-0.02em]">Good View</span>
      </a>
      <nav aria-label="Main" class="hidden items-center gap-8 text-[14px] md:flex">
        {
          navLinks.map((link) => (
            <a href={link.href} class="opacity-85 transition-opacity hover:opacity-100">
              {link.label}
            </a>
          ))
        }
      </nav>
      <a href="#contact" class="px-btn px-frame !h-10 !px-4 text-[14px]">
        Start a project
        <PixelIcon name="arrow" class="h-3 w-3.5" />
      </a>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section data-hero class="relative isolate flex min-h-[100svh] items-center overflow-hidden bg-ink-800 text-white">
      <img
        src="/images/hero-bg.avif"
        alt=""
        fetchpriority="high"
        class="absolute inset-0 -z-10 h-full w-full object-cover object-[55%_45%]"
      />
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-r from-black/45 via-black/10 to-transparent"></div>

      <div class="mx-auto w-full max-w-[1280px] px-5 pb-28 pt-28 sm:px-8">
        <div class="glass-card px-frame max-w-[620px] p-7 sm:p-10" style="--px-c: rgb(255 255 255 / 0.5)">
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-white/85">Bakersfield, California · independent studio</p>
          <h1 class="text-glow mt-5 font-pixel text-[clamp(2.4rem,5vw,3.8rem)] leading-[1.04] tracking-[-0.025em]">
            Websites and software your business runs on.
          </h1>
          <p class="mt-6 max-w-[46ch] text-[16px] leading-[1.6] text-white/95">
            Good View builds the site customers find you through and the tools your team uses every day. One developer, from first sketch to long-term support.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a href="#contact" class="px-btn px-frame">
              Start a project
              <PixelIcon name="arrow" class="h-3 w-3.5" />
            </a>
            <a href="#work" class="px-btn px-btn-ghost px-frame">See the work</a>
          </div>
        </div>
      </div>
      <Walker />
      <div aria-hidden="true" class="px-dither-edge"></div>
    </section>

    <!-- Proof strip: what you can count on, before anything else -->
    <section aria-label="How we work" class="border-b border-line">
      <ul class="mx-auto grid max-w-[1280px] divide-y divide-line px-5 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-8">
        {
          [
            ["Written quote first", "Scope and price agreed before development begins."],
            ["Nothing billed unapproved", "You approve the scope before any invoice."],
            ["Same person throughout", "Whoever scopes it builds it and supports it."],
          ].map(([title, body]) => (
            <li class="flex items-start gap-4 py-6 sm:px-6 sm:first:pl-0 sm:last:pr-0">
              <PixelIcon name="check" class="mt-1 h-4 w-4 shrink-0 text-leaf" />
              <div>
                <p class="text-[15px] font-semibold tracking-[-0.01em]">{title}</p>
                <p class="mt-1 text-[14px] leading-[1.5] text-ink-600">{body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Services -->
    <section id="services" class="px-5 py-[100px] sm:px-8 md:py-[140px]">
      <div class="mx-auto max-w-[1280px]">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-[640px]">
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-leaf-deep">What I build</p>
            <h2 class="mt-4 text-[clamp(2.1rem,4vw,3.2rem)] text-ink-800">Small businesses run on spreadsheets and old websites. They don't have to.</h2>
          </div>
          <a href="#contact" class="font-mono text-[12px] uppercase tracking-[0.12em] underline decoration-leaf decoration-2 underline-offset-[6px] hover:text-leaf-deep">
            Not sure which? Start here
          </a>
        </div>

        <div class="mt-14 grid gap-7 sm:grid-cols-2 lg:grid-cols-4">
          {
            services.map((service) => (
              <article class="px-frame group flex h-full flex-col bg-white p-6 transition-colors hover:bg-leaf-tint" style="--px: 2px">
                <PixelIcon name={service.icon} class="h-14 w-14 text-ink-950" />
                <div class="mt-7 flex items-baseline gap-3">
                  <span class="font-mono text-[11px] text-leaf-deep">{service.number}</span>
                  <h3 class="text-[28px] leading-none text-ink-800">{service.title}</h3>
                </div>
                <p class="mt-3 flex-1 text-[14px] leading-[1.6] text-ink-600">{service.body}</p>
                {service.example ? (
                  <a href="#work" class="mt-6 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-950 hover:text-leaf-deep">
                    {service.example}
                    <PixelIcon name="arrow" class="h-2.5 w-3" />
                  </a>
                ) : (
                  <span class="mt-6 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-400">Ask for a demo</span>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Work -->
    <section id="work" class="border-y border-line bg-paper-soft px-5 py-[100px] sm:px-8 md:py-[140px]">
      <div class="mx-auto max-w-[1280px]">
        <div class="max-w-[640px]">
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-leaf-deep">Recent work</p>
          <h2 class="mt-4 text-[clamp(2.1rem,4vw,3.2rem)] text-ink-800">Concept previews you can open.</h2>
          <p class="mt-4 max-w-[52ch] text-[15px] leading-[1.6] text-ink-600">
            Concept previews, not client work. Pick a project to see the kind of thing each one stands for, then open it and click around.
          </p>
        </div>
        <ProjectWheel />
        <div class="mt-12 flex flex-wrap items-center gap-5">
          <a href="#contact" class="px-btn px-frame">
            Start a project like this
            <PixelIcon name="arrow" class="h-3 w-3.5" />
          </a>
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-600">Quote in writing before any work</p>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section id="process" class="px-5 py-[100px] sm:px-8 md:py-[140px]">
      <div class="mx-auto max-w-[1280px]">
        <div class="max-w-[640px]">
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-leaf-deep">How a project runs</p>
          <h2 class="mt-4 text-[clamp(2.1rem,4vw,3.2rem)] text-ink-800">Four steps, one person.</h2>
        </div>

        <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0">
          {
            steps.map((step, index) => (
              <li class="relative lg:pr-8">
                <div class="flex items-center gap-4">
                  <span class="px-frame grid h-12 w-12 place-items-center bg-ink-950 font-pixel text-[26px] leading-none text-white" style="--px: 2px">
                    {index + 1}
                  </span>
                  {index < steps.length - 1 && <span aria-hidden="true" class="hidden h-0 flex-1 border-t-[3px] border-dotted border-ink-400 lg:block" />}
                </div>
                <h3 class="mt-6 text-[30px] leading-none text-ink-800">{step.title}</h3>
                <p class="mt-3 max-w-[30ch] text-[14px] leading-[1.6] text-ink-600">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Why / about: image band -->
    <section id="about" class="px-3 pb-3 sm:px-5 sm:pb-5">
      <div class="relative isolate overflow-hidden text-white">
        <img src="/images/hero-bg.avif" alt="" loading="lazy" class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_80%]" />
        <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-r from-black/70 via-black/40 to-black/10"></div>
        <div class="mx-auto grid max-w-[1280px] gap-12 px-6 py-20 sm:px-10 md:py-28 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-white/80">About</p>
            <h2 class="text-glow mt-4 text-[clamp(2.1rem,4vw,3.2rem)] leading-[1.06]">Built by the person you hire.</h2>
            <p class="mt-5 max-w-[42ch] text-[15px] leading-[1.6] text-white/90">
              I'm an independent developer based in Bakersfield. I build websites and business software for small businesses and nonprofits, and I do the work myself. No account managers, no hand-offs, no team you never meet.
            </p>
            <a href="#contact" class="px-btn px-btn-ghost px-frame mt-8">
              Talk to me
              <PixelIcon name="arrow" class="h-3 w-3.5" />
            </a>
          </div>
          <ul class="grid gap-5 sm:grid-cols-2 lg:col-span-7">
            {
              reasons.map((reason) => (
                <li class="glass-card px-frame p-6" style="--px: 2px; --px-c: rgb(255 255 255 / 0.4)">
                  <PixelIcon name="check" class="h-4 w-4 text-white" />
                  <h3 class="text-glow mt-3 text-[26px] leading-[1.05]">{reason.title}</h3>
                  <p class="mt-2 text-[14px] leading-[1.55] text-white/90">{reason.body}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="px-5 py-[100px] sm:px-8 md:py-[140px]">
      <div class="mx-auto grid max-w-[1280px] gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-leaf-deep">Questions</p>
          <h2 class="mt-4 text-[clamp(2.1rem,4vw,3.2rem)] text-ink-800">Before you get in touch.</h2>
          <p class="mt-4 max-w-[34ch] text-[15px] leading-[1.6] text-ink-600">Not answered here? Tell me about your project and ask directly.</p>
        </div>
        <div class="lg:col-span-8">
          {
            faqs.map((item) => (
              <details class="group border-t border-line last:border-b">
                <summary class="flex cursor-pointer items-center justify-between gap-6 py-6 text-[18px] font-semibold tracking-[-0.01em] focus-visible:outline-offset-[-2px]">
                  {item.q}
                  <span class="shrink-0 text-ink-950">
                    <PixelIcon name="plus" class="h-4 w-4 group-open:hidden" />
                    <PixelIcon name="minus" class="hidden h-4 w-4 group-open:block" />
                  </span>
                </summary>
                <p class="max-w-[62ch] pb-6 text-[15px] leading-[1.65] text-ink-600">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact: a short brief that sets up the first conversation -->
    <section id="contact" class="border-t border-line bg-paper-soft px-5 py-[100px] sm:px-8 md:py-[140px]">
      <div class="mx-auto grid max-w-[1280px] gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-leaf-deep">Start a project</p>
          <h2 class="mt-4 text-[clamp(2.1rem,4vw,3.2rem)] text-ink-800">Tell me what you need.</h2>
          <p class="mt-5 max-w-[40ch] text-[15px] leading-[1.6] text-ink-600">
            Pick what fits, and the first message writes itself. You get a written scope and a quote before any work begins.
          </p>
        </div>

        <div data-brief data-email={email ?? ""} class="px-frame bg-white p-6 sm:p-9 lg:col-span-7" style="--px: 3px">
          <fieldset>
            <legend class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-600">1 · What do you need?</legend>
            <div class="mt-4 flex flex-wrap gap-3.5">
              {needs.map((label) => <button type="button" data-group="need" aria-pressed="false" class="px-chip px-frame">{label}</button>)}
            </div>
          </fieldset>
          <fieldset class="mt-9">
            <legend class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-600">2 · When?</legend>
            <div class="mt-4 flex flex-wrap gap-3.5">
              {timelines.map((label) => <button type="button" data-group="when" aria-pressed="false" class="px-chip px-frame">{label}</button>)}
            </div>
          </fieldset>

          <div class="mt-9 border-t border-line pt-6">
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-600">Your message</p>
            <p data-brief-summary aria-live="polite" class="mt-3 min-h-[3.2em] text-[15px] leading-[1.6] text-ink-800">
              Choose one or more above.
            </p>

            {
              email ? (
                <a data-brief-send href="#" class="px-btn px-frame mt-6">
                  Email this to Good View
                  <PixelIcon name="arrow" class="h-3 w-3.5" />
                </a>
              ) : (
                <p class="mt-6 inline-flex items-center gap-3 font-mono text-[12px] uppercase tracking-[0.12em] text-ink-800">
                  <span class="h-2.5 w-2.5 bg-leaf" aria-hidden="true" />
                  {site.inquiriesNote}
                </p>
              )
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-4 px-5 py-9 text-[13px] text-ink-600 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <div class="flex items-center gap-3">
        <PixelIcon name="mark" class="h-5 w-5 text-ink-950" />
        <p>© {new Date().getFullYear()} {site.name} · {site.location}</p>
      </div>
      <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-1">
        <a href="#services" class="hover:text-ink-950">Services</a>
        <a href="#work" class="hover:text-ink-950">Work</a>
        <a href="#process" class="hover:text-ink-950">Process</a>
        <a href="#faq" class="hover:text-ink-950">FAQ</a>
        <a href="#contact" class="hover:text-ink-950">Contact</a>
      </nav>
      <p>Operated by {site.operator}</p>
    </div>
  </footer>
</Layout>

<script>
  // Header: glass over the hero image, solid once the hero has scrolled away.
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (header && hero) {
    const sync = () => {
      header.dataset.solid = String(hero.getBoundingClientRect().bottom < 72);
    };
    sync();
    addEventListener("scroll", sync, { passive: true });
    addEventListener("resize", sync);
  }

  // Project brief: chips build the first message.
  const brief = document.querySelector<HTMLElement>("[data-brief]");
  if (brief) {
    const summary = brief.querySelector<HTMLElement>("[data-brief-summary]")!;
    const send = brief.querySelector<HTMLAnchorElement>("[data-brief-send]");
    const email = brief.dataset.email ?? "";
    const chips = [...brief.querySelectorAll<HTMLButtonElement>("button[data-group]")];

    const selected = (group: string) =>
      chips.filter((chip) => chip.dataset.group === group && chip.getAttribute("aria-pressed") === "true").map((chip) => chip.textContent!.trim());

    const update = () => {
      const needs = selected("need");
      const [when] = selected("when");
      const parts: string[] = [];
      if (needs.length) parts.push(`I'm looking for: ${needs.join(", ")}.`);
      if (when) parts.push(`Timeline: ${when.toLowerCase()}.`);
      const text = parts.join(" ");
      summary.textContent = text || "Choose one or more above.";
      if (send) {
        const body = `${text || "I'd like to talk about a project."}\n\nAbout my business:\n\nWhat's difficult right now:\n`;
        send.href = `mailto:${email}?subject=${encodeURIComponent("Project inquiry")}&body=${encodeURIComponent(body)}`;
      }
    };

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        const single = chip.dataset.group === "when";
        const next = chip.getAttribute("aria-pressed") !== "true";
        if (single) for (const other of chips) if (other.dataset.group === "when") other.setAttribute("aria-pressed", "false");
        chip.setAttribute("aria-pressed", String(next));
        update();
      });
    }
    update();
  }
</script>
