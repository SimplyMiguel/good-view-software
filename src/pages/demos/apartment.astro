---
import "../../styles/demo-apartment.css";
import { formatPrice, initialPlacements, kinds, variantsById } from "../../demos/apartment/catalog";

const startTotal = initialPlacements.reduce((sum, p) => sum + (variantsById.get(p.variantId)?.price ?? 0), 0);
const groups = [...new Set(kinds.map((k) => k.label))];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Studio 01 — 450 sq ft · Shoppable room concept</title>
  </head>
  <body class="font-apt-sans bg-apt-paper text-apt-ink">
    <div id="stage" class="relative h-dvh w-full overflow-hidden">
      <canvas id="scene" class="absolute inset-0 block h-full w-full"></canvas>
      <svg data-dims class="pointer-events-none absolute inset-0 z-[5] h-full w-full" aria-hidden="true"></svg>

      <header class="pointer-events-none absolute left-0 right-0 top-0 z-10 flex flex-col gap-2.5 p-5 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
        <div>
          <p class="font-apt-mono text-[10px] uppercase tracking-[0.14em] text-apt-muted">Shoppable room concept</p>
          <h1 class="mt-1.5 whitespace-nowrap text-[24px] leading-none tracking-tight sm:text-[30px]">Studio 01 — 450 sq ft</h1>
        </div>
        <div class="flex shrink-0 items-center gap-1.5 whitespace-nowrap sm:gap-2">
          <span class="rounded-full bg-white/70 px-3 py-1.5 text-[12px] tabular-nums backdrop-blur sm:text-[13px]">
            <span data-count>11</span> items · <span data-total>{formatPrice(startTotal)}</span>
          </span>
          <button type="button" data-restore class="pointer-events-auto rounded-full border border-apt-line bg-white/70 px-2.5 py-1.5 font-apt-mono text-[9px] uppercase tracking-[0.1em] backdrop-blur transition-colors hover:bg-white sm:px-3 sm:text-[10px] sm:tracking-[0.12em]">
            Restore
          </button>
          <button type="button" data-reset class="pointer-events-auto rounded-full border border-apt-line bg-white/70 px-2.5 py-1.5 font-apt-mono text-[9px] uppercase tracking-[0.1em] backdrop-blur transition-colors hover:bg-white sm:px-3 sm:text-[10px] sm:tracking-[0.12em]">
            Reset view
          </button>
          <button type="button" data-mode aria-pressed="false" class="pointer-events-auto rounded-full border border-apt-ink bg-apt-ink px-2.5 py-1.5 font-apt-mono text-[9px] uppercase tracking-[0.1em] text-apt-paper transition-colors hover:bg-apt-accent hover:border-apt-accent sm:px-3 sm:text-[10px] sm:tracking-[0.12em]">
            Walk inside
          </button>
        </div>
      </header>

      <!-- Left rail: what is in the room -->
      <nav
        aria-label="Items in this room"
        class="pointer-events-auto absolute bottom-16 left-0 right-0 z-10 hidden max-h-[46dvh] overflow-y-auto px-5 sm:bottom-auto sm:left-5 sm:right-auto sm:top-[104px] sm:block sm:max-h-[calc(100dvh-210px)] sm:w-[260px] sm:px-0"
      >
        <p class="mb-1.5 px-2.5 font-apt-mono text-[10px] uppercase tracking-[0.14em] text-apt-muted">In this room</p>
        <ul data-list class="flex flex-col gap-0.5"></ul>
      </nav>

      <!-- Right panel: add something -->
      <aside
        aria-label="Add to this room"
        class="pointer-events-auto absolute bottom-4 right-4 z-10 hidden w-[272px] max-h-[calc(100dvh-170px)] overflow-y-auto rounded-xl border border-apt-line bg-white/80 p-3 backdrop-blur-md sm:block"
      >
        <p class="mb-2 font-apt-mono text-[10px] uppercase tracking-[0.14em] text-apt-muted">Add to room</p>
        {
          groups.map((group) => (
            <div class="mb-2.5 last:mb-0">
              <p class="mb-1 text-[10px] uppercase tracking-[0.1em] text-apt-muted/80">{group}</p>
              <div class="flex flex-wrap gap-1">
                {kinds
                  .filter((k) => k.label === group)
                  .map(({ kind }) => (
                    <button
                      type="button"
                      data-add={kind}
                      class="rounded-full border border-apt-line bg-white px-2.5 py-1 text-[11px] capitalize transition-colors hover:border-apt-ink hover:bg-apt-ink hover:text-apt-paper"
                    >
                      + {kind === "coffee" ? "coffee table" : kind === "counter" ? "kitchen run" : kind === "table" ? "dining table" : kind}
                    </button>
                  ))}
              </div>
            </div>
          ))
        }
      </aside>

      <!-- Mobile strip: picker of kinds -->
      <div class="pointer-events-auto absolute bottom-12 left-0 right-0 z-10 flex gap-1.5 overflow-x-auto whitespace-nowrap px-4 pb-1 sm:hidden">
        {
          kinds.map(({ kind }) => (
            <button type="button" data-add={kind} class="shrink-0 rounded-full border border-apt-line bg-white/90 px-3 py-1.5 text-[11px] capitalize">
              + {kind}
            </button>
          ))
        }
      </div>

      <div
        data-card
        hidden
        class="pointer-events-auto absolute z-20 w-[264px] rounded-xl border border-apt-line bg-white/92 p-3.5 shadow-[0_8px_30px_rgba(34,32,28,0.14)] backdrop-blur-md"
      >
        <p data-card-category class="font-apt-mono text-[10px] uppercase tracking-[0.12em] text-apt-muted"></p>
        <h2 data-card-name class="mt-1 text-[17px] leading-tight tracking-tight"></h2>
        <p data-card-price class="mt-1 text-[15px] tabular-nums"></p>

        <dl class="mt-2.5 grid grid-cols-3 gap-1.5 text-center">
          <div class="rounded-md bg-apt-paper px-1 py-1.5"><dt class="font-apt-mono text-[9px] uppercase tracking-[0.1em] text-apt-muted">Width</dt><dd data-card-w class="text-[12px] tabular-nums"></dd></div>
          <div class="rounded-md bg-apt-paper px-1 py-1.5"><dt class="font-apt-mono text-[9px] uppercase tracking-[0.1em] text-apt-muted">Depth</dt><dd data-card-d class="text-[12px] tabular-nums"></dd></div>
          <div class="rounded-md bg-apt-paper px-1 py-1.5"><dt class="font-apt-mono text-[9px] uppercase tracking-[0.1em] text-apt-muted">Height</dt><dd data-card-h class="text-[12px] tabular-nums"></dd></div>
        </dl>

        <div class="mt-2.5 flex items-center gap-2">
          <span data-card-swatch class="h-3.5 w-3.5 shrink-0 rounded-full border border-apt-line"></span>
          <span data-card-color class="text-[12px] text-apt-muted"></span>
        </div>

        <div data-card-variants hidden class="mt-3 border-t border-apt-line pt-2.5">
          <p class="mb-1.5 font-apt-mono text-[9px] uppercase tracking-[0.12em] text-apt-muted">Swap style</p>
          <div data-card-variant-list class="flex flex-wrap gap-1"></div>
        </div>

        <div data-card-actions hidden class="mt-3 grid grid-cols-2 gap-1.5">
          <button type="button" data-rotate class="rounded-md border border-apt-line bg-white px-2 py-1.5 text-[11px] uppercase tracking-[0.1em] transition-colors hover:bg-apt-paper">Rotate 90°</button>
          <button type="button" data-remove class="rounded-md border border-apt-line bg-white px-2 py-1.5 text-[11px] uppercase tracking-[0.1em] text-apt-accent transition-colors hover:bg-apt-accent hover:text-white">Remove</button>
        </div>

        <a href="#" data-demo-link aria-disabled="true" class="mt-3 block rounded-md bg-apt-ink px-3 py-2 text-center text-[11px] uppercase tracking-[0.12em] text-apt-paper">View on Amazon ↗</a>
        <p class="mt-1.5 text-[10px] text-apt-muted">Demo content — prices, sizes and links are illustrative. Example link — no real product.</p>
      </div>

      <p data-hint class="pointer-events-none absolute bottom-4 left-5 z-10 hidden whitespace-nowrap font-apt-mono text-[10px] uppercase tracking-[0.12em] text-apt-muted sm:block">
        Drag a piece to move · Drag empty space to orbit · Scroll to zoom
      </p>

      <!-- Walk mode: stand at named spots; WASD / arrows walk, drag looks around -->
      <div data-spots hidden class="pointer-events-auto absolute left-1/2 top-[84px] z-10 -translate-x-1/2 flex-wrap items-center justify-center gap-1.5 sm:top-5">
        <span class="font-apt-mono text-[10px] uppercase tracking-[0.12em] text-apt-muted">Stand at</span>
        <button type="button" data-spot="middle" class="rounded-full border border-apt-line bg-white/80 px-2.5 py-1 text-[11px] backdrop-blur hover:bg-white">Middle</button>
        <button type="button" data-spot="door" class="rounded-full border border-apt-line bg-white/80 px-2.5 py-1 text-[11px] backdrop-blur hover:bg-white">Entry</button>
        <button type="button" data-spot="bed" class="rounded-full border border-apt-line bg-white/80 px-2.5 py-1 text-[11px] backdrop-blur hover:bg-white">Bed</button>
        <button type="button" data-spot="kitchen" class="rounded-full border border-apt-line bg-white/80 px-2.5 py-1 text-[11px] backdrop-blur hover:bg-white">Kitchen</button>
        <button type="button" data-spot="window" class="rounded-full border border-apt-line bg-white/80 px-2.5 py-1 text-[11px] backdrop-blur hover:bg-white">Window wall</button>
      </div>

      <!-- Shown when a drag was rejected and the piece snapped back -->
      <p data-toast hidden role="status" class="pointer-events-none absolute left-1/2 top-[150px] z-30 -translate-x-1/2 rounded-full bg-apt-ink px-4 py-2 text-[12px] text-apt-paper shadow-lg sm:top-[84px]">
        That spot is taken — the piece went back.
      </p>

      <p data-fallback hidden class="absolute inset-0 grid place-items-center text-center text-[13px] text-apt-muted">
        This preview needs WebGL, which your browser has turned off.
      </p>
    </div>

    <script>
      import { formatPrice, formatDims, variantsById, variantsByKind, initialPlacements, kinds, type Placement } from "../../demos/apartment/catalog";
      import { createViewer, type Viewer } from "../../demos/apartment/scene";

      const stage = document.getElementById("stage") as HTMLElement;
      const $ = <T extends HTMLElement>(sel: string) => stage.querySelector<T>(sel)!;
      const card = $("[data-card]");
      const dims = stage.querySelector<SVGSVGElement>("[data-dims]")!;
      const list = $("[data-list]");
      const fallback = $("[data-fallback]");
      const demoLink = $("[data-demo-link]");

      let viewer: Viewer | null = null;
      try {
        viewer = createViewer(stage);
      } catch {
        fallback.hidden = false;
      }

      if (viewer) {
        const v = viewer;
        let placements: Placement[] = initialPlacements.map((p) => ({ ...p }));
        let pinned: string | null = null;
        let focus: string | null = null;
        let seq = 0;

        const kindOf = (p: Placement) => variantsById.get(p.variantId)!.kind;
        const labelFor = (kind: string) => kinds.find((k) => k.kind === kind)?.label ?? "";

        const refreshHud = () => {
          const total = placements.reduce((sum, p) => sum + (variantsById.get(p.variantId)?.price ?? 0), 0);
          $("[data-total]").textContent = formatPrice(total);
          $("[data-count]").textContent = String(placements.length);
        };

        const renderList = () => {
          list.replaceChildren(
            ...placements.map((p) => {
              const variant = variantsById.get(p.variantId)!;
              const li = document.createElement("li");
              const button = document.createElement("button");
              button.type = "button";
              button.dataset.item = p.id;
              button.className =
                "flex w-full items-baseline justify-between gap-3 rounded-md border border-transparent px-2.5 py-1.5 text-left text-[12px] transition-colors hover:border-apt-line hover:bg-white/70 focus-visible:border-apt-accent focus-visible:outline-none data-[on=true]:border-apt-line data-[on=true]:bg-white";
              button.dataset.on = String(p.id === pinned);
              const name = document.createElement("span");
              name.className = "truncate";
              name.textContent = variant.name;
              const price = document.createElement("span");
              price.className = "font-apt-mono text-[11px] tabular-nums text-apt-muted";
              price.textContent = formatPrice(variant.price);
              button.append(name, price);
              button.addEventListener("pointerenter", () => show(p.id, "list"));
              button.addEventListener("pointerleave", () => {
                if (!pinned) hide();
              });
              button.addEventListener("click", () => pin(p.id));
              li.append(button);
              return li;
            }),
          );
        };

        const sync = () => {
          v.setPlacements(placements);
          refreshHud();
          renderList();
        };

        // ── Dimension lines ────────────────────────────────────────────────
        const NS = "http://www.w3.org/2000/svg";
        const line = (a: { x: number; y: number }, b: { x: number; y: number }, label: string) => {
          const g = document.createElementNS(NS, "g");
          const path = document.createElementNS(NS, "path");
          path.setAttribute("d", `M${a.x},${a.y}L${b.x},${b.y}`);
          path.setAttribute("stroke", "#22201c");
          path.setAttribute("stroke-width", "1");
          path.setAttribute("stroke-opacity", "0.55");
          path.setAttribute("fill", "none");
          g.append(path);
          for (const end of [a, b]) {
            const tick = document.createElementNS(NS, "circle");
            tick.setAttribute("cx", String(end.x));
            tick.setAttribute("cy", String(end.y));
            tick.setAttribute("r", "2");
            tick.setAttribute("fill", "#22201c");
            tick.setAttribute("fill-opacity", "0.6");
            g.append(tick);
          }
          const text = document.createElementNS(NS, "text");
          const mx = (a.x + b.x) / 2;
          const my = (a.y + b.y) / 2;
          text.setAttribute("x", String(mx));
          text.setAttribute("y", String(my - 6));
          text.setAttribute("text-anchor", "middle");
          text.setAttribute("font-size", "10");
          text.setAttribute("font-family", "ui-monospace, Menlo, monospace");
          text.setAttribute("fill", "#22201c");
          text.setAttribute("paint-order", "stroke");
          text.setAttribute("stroke", "#f5f3ee");
          text.setAttribute("stroke-width", "3");
          text.textContent = label;
          g.append(text);
          return g;
        };

        const drawDims = () => {
          if (!focus) {
            dims.replaceChildren();
            return;
          }
          const a = v.anchors(focus);
          if (!a) {
            dims.replaceChildren();
            return;
          }
          dims.replaceChildren(line(a.width.a, a.width.b, a.width.label), line(a.depth.a, a.depth.b, a.depth.label), line(a.height.a, a.height.b, a.height.label));
        };
        v.setFrameListener(drawDims);

        // ── Card ───────────────────────────────────────────────────────────
        const place = (x: number, y: number) => {
          const rect = stage.getBoundingClientRect();
          const w = card.offsetWidth;
          const h = card.offsetHeight;
          if (rect.width < 640) {
            card.style.left = "16px";
            card.style.top = `${Math.max(8, rect.height - h - 150)}px`;
            return;
          }
          card.style.left = `${Math.min(Math.max(x + 18, 8), Math.max(8, rect.width - w - 300))}px`;
          card.style.top = `${Math.min(Math.max(y + 18, 8), Math.max(8, rect.height - h - 8))}px`;
        };

        let lastPoint = { x: 0, y: 0 };

        const fill = (id: string) => {
          const placement = placements.find((p) => p.id === id);
          const variant = placement && variantsById.get(placement.variantId);
          if (!placement || !variant) return false;
          $("[data-card-category]").textContent = labelFor(variant.kind);
          $("[data-card-name]").textContent = variant.name;
          $("[data-card-price]").textContent = formatPrice(variant.price);
          $("[data-card-w]").textContent = `${variant.w}″`;
          $("[data-card-d]").textContent = `${variant.d}″`;
          $("[data-card-h]").textContent = `${variant.h}″`;
          $("[data-card-swatch]").style.background = variant.colorHex;
          $("[data-card-color]").textContent = `${variant.color} · ${formatDims(variant)}`;

          const siblings = variantsByKind.get(variant.kind) ?? [];
          const swapBox = $("[data-card-variants]");
          const swapList = $("[data-card-variant-list]");
          swapBox.hidden = siblings.length < 2 || pinned !== id;
          swapList.replaceChildren(
            ...siblings.map((s) => {
              const b = document.createElement("button");
              b.type = "button";
              const current = s.id === variant.id;
              // A size that would hit a neighbour or a wall is offered but disabled.
              const fits = current || v.fits(s.id, placement.x, placement.z, placement.rotationY, id);
              b.className =
                "rounded-full border px-2 py-1 text-[10px] transition-colors " +
                (current ? "border-apt-ink bg-apt-ink text-apt-paper " : "border-apt-line bg-white hover:border-apt-ink ") +
                (fits ? "" : "cursor-not-allowed opacity-40 hover:border-apt-line");
              b.textContent = `${s.name.replace(/,.*/, "")} · ${formatPrice(s.price)}`;
              b.disabled = !fits;
              b.title = fits ? "" : "Does not fit here";
              b.addEventListener("click", () => {
                placements = placements.map((p) => (p.id === id ? { ...p, variantId: s.id } : p));
                sync();
                focus = id;
                fill(id);
                v.setHighlight(id);
              });
              return b;
            }),
          );
          $("[data-card-actions]").hidden = pinned !== id;
          card.hidden = false;
          return true;
        };

        const show = (id: string, from: "scene" | "list") => {
          if (pinned && pinned !== id) return;
          focus = id;
          v.setHighlight(id);
          if (!fill(id)) return;
          if (from === "list") {
            lastPoint = { x: 284, y: 120 };
            place(lastPoint.x, lastPoint.y);
          }
          drawDims();
        };

        const hide = () => {
          if (pinned) return;
          focus = null;
          card.hidden = true;
          v.setHighlight(null);
          drawDims();
        };

        const unpin = () => {
          pinned = null;
          card.removeAttribute("data-pinned");
          hide();
          renderList();
        };

        const pin = (id: string) => {
          pinned = id;
          focus = id;
          card.setAttribute("data-pinned", "");
          v.setHighlight(id);
          fill(id);
          place(lastPoint.x, lastPoint.y);
          renderList();
          drawDims();
        };

        v.setHoverListener(({ id, x, y }) => {
          if (pinned) return;
          if (!id) return hide();
          lastPoint = { x, y };
          show(id, "scene");
          place(x, y);
        });

        v.setSelectListener(({ id, x, y }) => {
          lastPoint = { x, y };
          if (!id) return unpin();
          pin(id);
        });

        v.setMoveListener((event) => {
          if (!event) return;
          const index = placements.findIndex((p) => p.id === event.placement.id);
          if (index >= 0) placements[index] = event.placement;
          if (!pinned) pin(event.placement.id);
          drawDims();
        });

        // ── Add / remove / rotate ──────────────────────────────────────────
        const spawn = (kind: string) => {
          // One bed only: the Bed button then focuses the existing bed so its size can be changed.
          if (kind === "bed") {
            const existing = placements.find((p) => variantsById.get(p.variantId)?.kind === "bed");
            if (existing) {
              lastPoint = v.centre(existing.id) ?? { x: stage.clientWidth * 0.5, y: stage.clientHeight * 0.45 };
              pin(existing.id);
              toast("There is already a bed — pick a size below.");
              return;
            }
          }
          const options = variantsByKind.get(kind as never) ?? [];
          // New beds start at Full: it is the one most likely to fit a studio.
          const variant = kind === "bed" ? (options.find((o) => o.id === "bed-full") ?? options[0]) : options[0];
          if (!variant) return;
          const rotationY = kind === "sofa" ? Math.PI : 0;
          seq += 1;
          const id = `${kind}-${seq}`;
          const spot = findOpenSpot(variant.id, rotationY);
          if (!spot) {
            toast(`No room left for a ${kind}.`);
            return;
          }
          placements = [...placements, { id, variantId: variant.id, x: spot.x, z: spot.z, rotationY }];
          sync();
          lastPoint = { x: stage.clientWidth * 0.5, y: stage.clientHeight * 0.45 };
          pin(id);
        };

        // Nearest free floor to the room centre. The grid is coarse on purpose:
        // this runs on click, not per frame. Returns null when nothing fits.
        const findOpenSpot = (variantId: string, rotationY: number) => {
          let best: { x: number; z: number } | null = null;
          let bestScore = Number.POSITIVE_INFINITY;
          for (let x = -3; x <= 3; x += 0.1) {
            for (let z = -2.6; z <= 2.6; z += 0.1) {
              if (!v.fits(variantId, x, z, rotationY)) continue;
              const score = x * x + z * z;
              if (score < bestScore) {
                bestScore = score;
                best = { x, z };
              }
            }
          }
          return best;
        };

        const remove = (id: string) => {
          placements = placements.filter((p) => p.id !== id);
          pinned = null;
          focus = null;
          card.hidden = true;
          card.removeAttribute("data-pinned");
          sync();
          drawDims();
        };

        const rotate = (id: string) => {
          const current = placements.find((p) => p.id === id);
          if (!current) return;
          const rotationY = ((current.rotationY ?? 0) + Math.PI / 2) % (Math.PI * 2);
          if (!v.fits(current.variantId, current.x, current.z, rotationY, id)) {
            toast("Not enough room to turn it here.");
            return;
          }
          placements = placements.map((p) => (p.id === id ? { ...p, rotationY } : p));
          sync();
          pin(id);
        };

        stage.querySelectorAll<HTMLElement>("[data-add]").forEach((button) => {
          button.addEventListener("click", () => spawn(button.dataset.add!));
        });

        let toastTimer = 0;
        const toast = (message: string) => {
          const el = $("[data-toast]");
          el.textContent = message;
          el.hidden = false;
          clearTimeout(toastTimer);
          toastTimer = window.setTimeout(() => (el.hidden = true), 2200);
        };
        v.setBlockedListener((blocked) => {
          if (blocked) toast("That spot is taken — the piece went back.");
        });
        $("[data-remove]").addEventListener("click", () => pinned && remove(pinned));
        $("[data-rotate]").addEventListener("click", () => pinned && rotate(pinned));
        $("[data-restore]").addEventListener("click", () => {
          placements = initialPlacements.map((p) => ({ ...p }));
          pinned = null;
          focus = null;
          card.hidden = true;
          sync();
          drawDims();
        });
        $("[data-reset]").addEventListener("click", () => {
          setWalk(false);
          v.resetView();
          unpin();
        });
        demoLink.addEventListener("click", (event) => event.preventDefault());

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            if (pinned) {
              unpin();
              event.preventDefault();
              return;
            }
            if (window.parent !== window) {
              window.parent.postMessage({ type: "preview-close" }, window.location.origin);
            }
            return;
          }
          if (!pinned) return;
          if (event.key === "Delete" || event.key === "Backspace") {
            event.preventDefault();
            remove(pinned);
          } else if (event.key.toLowerCase() === "r") {
            event.preventDefault();
            rotate(pinned);
          }
        });

        window.addEventListener("resize", () => {
          if (!card.hidden && pinned) place(lastPoint.x, lastPoint.y);
        });

        sync();

        // ── Walk mode ──────────────────────────────────────────────────────
        const spotsBar = $("[data-spots]");
        const modeButton = $("[data-mode]");
        const hint = $("[data-hint]");

        const bedPlacement = () => placements.find((p) => variantsById.get(p.variantId)?.kind === "bed");
        const SPOTS: Record<string, () => [number, number, number, number]> = {
          middle: () => [0, 0, 0, -3],
          door: () => [2.6, 2.2, -2.6, -1],
          window: () => [-2.5, 2.1, 2.5, -1.5],
          kitchen: () => {
            const k = placements.find((p) => variantsById.get(p.variantId)?.kind === "counter");
            return k ? [k.x - 1.1, k.z, k.x, k.z] : [1, 0, 3, 0];
          },
          bed: () => {
            const b = bedPlacement();
            return b ? [b.x + 1.4, b.z + 1.6, b.x, b.z] : [0, 1, -2, -2];
          },
        };

        const setWalk = (walking: boolean) => {
          v.setMode(walking ? "walk" : "orbit");
          modeButton.setAttribute("aria-pressed", String(walking));
          modeButton.textContent = walking ? "Back to overview" : "Walk inside";
          spotsBar.hidden = !walking;
          spotsBar.style.display = walking ? "flex" : "";
          hint.textContent = walking
            ? "W A S D or arrows to walk · Drag to look around"
            : "Drag a piece to move · Drag empty space to orbit · Scroll to zoom";
          if (walking) {
            unpin();
            dims.replaceChildren();
            v.standAt(...SPOTS.middle());
          }
        };

        modeButton.addEventListener("click", () => setWalk(v.getMode() !== "walk"));
        spotsBar.querySelectorAll<HTMLElement>("[data-spot]").forEach((button) => {
          button.addEventListener("click", () => v.standAt(...SPOTS[button.dataset.spot!]()));
        });

        (window as any).__aptViewer = {
          get ready() {
            return true;
          },
          get itemCount() {
            return placements.length;
          },
          get mode() {
            return v.getMode();
          },
          placements: () => placements.map((p) => ({ ...p })),
          screenPoint: (id: string) => v.centre(id),
          floorPoint: (x: number, y: number) => v.floorPointAt(x, y),
          eye: () => v.eye(),
          tint: (id: string) => v.tint(id),
          fits: (variantId: string, x: number, z: number, rotationY?: number, ignoreId?: string) => v.fits(variantId, x, z, rotationY, ignoreId),
          setWalk,
        };
      }
    </script>
  </body>
</html>