<dialog data-site-preview aria-label="Restaurant website preview" class="site-preview">
  <div class="flex h-11 items-center justify-between bg-ink-950 px-4 text-paper">
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="h-2 w-2 rounded-full bg-paper/30"></span>
      <span class="h-2 w-2 rounded-full bg-paper/30"></span>
      <span class="h-2 w-2 rounded-full bg-paper/30"></span>
    </span>
    <span class="truncate px-3 font-mono text-[11px]">etxea.example — concept site, not a real restaurant</span>
    <button type="button" data-site-preview-close class="shrink-0 whitespace-nowrap font-mono text-[11px] uppercase tracking-[0.1em]">Close ✕</button>
  </div>
  <iframe data-site-preview-frame title="Etxea restaurant website preview" class="block h-[calc(100%-44px)] w-full border-0 bg-white"></iframe>
</dialog>

<style>
  .site-preview {
    width: min(1280px, calc(100vw - 48px));
    height: calc(100dvh - 48px);
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: #111;
  }
  .site-preview::backdrop {
    background: rgb(17 17 17 / 0.72);
    backdrop-filter: blur(2px);
  }
  @media (max-width: 639px) {
    .site-preview {
      width: 100vw;
      height: 100dvh;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("dialog[data-site-preview]");
  const frame = document.querySelector<HTMLIFrameElement>("[data-site-preview-frame]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-site-preview-close]");

  if (dialog && frame && closeButton) {
    const open = () => {
      if (!frame.getAttribute("src")) frame.src = "/demos/restaurant";
      dialog.showModal();
      document.documentElement.style.overflow = "hidden";
    };

    document.querySelectorAll<HTMLElement>("[data-open-site-preview]").forEach((el) => {
      el.addEventListener("click", open);
    });
    closeButton.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    window.addEventListener("message", (event) => {
      if (event.origin === window.location.origin && event.source === frame.contentWindow && event.data?.type === "site-preview-close") {
        dialog.close();
      }
    });
    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
    });
  }
</script>
