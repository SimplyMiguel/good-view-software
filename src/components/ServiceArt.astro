---
interface Props {
  kind: "website" | "viewer" | "mobile" | "tools";
}

const { kind } = Astro.props;
---

<svg
  viewBox="0 0 120 96"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class="h-[96px] w-auto"
>
  {
    kind === "website" && (
      <g>
        <path d="M14 63c10-26 22-34 32-18 10 17 8 28 22 27 12-1 16-13 24-27 5-9 11-11 16-4" />
        <circle cx="24" cy="49" r="3.5" />
        <circle cx="58" cy="64" r="4.5" />
        <circle cx="93" cy="43" r="3.5" />
        <circle cx="108" cy="41" r="2.5" />
      </g>
    )
  }
  {
    kind === "tools" && (
      <g>
        <circle cx="45" cy="43" r="21" />
        <circle cx="68" cy="43" r="21" />
        <circle cx="56.5" cy="61" r="16" />
        <rect x="86" y="18" width="16" height="16" />
      </g>
    )
  }
  {
    kind === "viewer" && (
      <g>
        <path d="M60 14l34 19v38L60 90 26 71V33z" />
        <path d="M60 14v38m0 0v38m0-38l34-19m-34 19L26 33" stroke-dasharray="2 3.5" />
        <circle cx="60" cy="52" r="2.5" />
      </g>
    )
  }
  {
    kind === "mobile" && (
      <g>
        <rect x="38" y="8" width="44" height="80" rx="7" />
        <path d="M54 15h12" />
        <rect x="45" y="26" width="30" height="14" />
        <rect x="45" y="46" width="30" height="10" />
        <circle cx="60" cy="76" r="3.5" />
      </g>
    )
  }
</svg>