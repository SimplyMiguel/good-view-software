---
/**
 * CSS-only iPhone. Same construction as the phone on 802.software, restyled to
 * this site: graphite band instead of titanium, hairline warm highlight, and a
 * near-invisible screen sheen. No images, no canvas — just gradients, insets and
 * two pseudo-element side buttons, so it costs nothing to load.
 *
 * The screen slot takes any markup, which keeps the content crisp at every size.
 */
interface Props {
  /** CSS width of the device, e.g. "170px". Everything else scales from it. */
  width?: string;
  /** Accessible description of what the screen shows. */
  label: string;
  /** Draw the Dynamic Island cutout. */
  island?: boolean;
}

const { width = "170px", label, island = true } = Astro.props;
---

<div class="phone" style={`--phone-w:${width}`} role="img" aria-label={label}>
  <div class="phone-screen">
    {island && <span class="phone-island" aria-hidden="true"></span>}
    <div class="phone-ui">
      <slot />
    </div>
    <span class="phone-glare" aria-hidden="true"></span>
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: var(--phone-w);
    padding: calc(var(--phone-w) * 0.028);
    /* Radius tunes with size, exactly like a real 9:19.5 body. */
    border-radius: calc(var(--phone-w) * 0.155);
    /* Graphite rail: bright edge top-left, shadow bottom-right, ink core. */
    background: linear-gradient(
      158deg,
      #8f8f88 0 1.5%,
      #4c4c47 7%,
      #262624 20%,
      #191918 46%,
      #202020 66%,
      #3e3e3a 86%,
      #6f6f68 97%,
      #8a8a82 100%
    );
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.3),
      inset 0 0 0 2px var(--color-ink-950),
      0 0 0 1px rgb(255 255 255 / 0.14),
      0 1px 2px rgb(17 17 17 / 0.22),
      0 18px 32px -14px rgb(17 17 17 / 0.4),
      0 40px 60px -34px rgb(17 17 17 / 0.28);
  }

  /* Volume buttons and mute switch on the left, power on the right. */
  .phone::before,
  .phone::after {
    content: "";
    position: absolute;
    width: calc(var(--phone-w) * 0.012);
    border-radius: 2px;
    background: linear-gradient(90deg, #1b1b1a, #5c5c57 55%, #292927);
  }
  .phone::before {
    left: calc(var(--phone-w) * -0.007);
    top: 17%;
    height: 29%;
    background: linear-gradient(
      180deg,
      #454540 0 15%,
      transparent 15% 27%,
      #454540 27% 58%,
      transparent 58% 67%,
      #454540 67% 100%
    );
  }
  .phone::after {
    right: calc(var(--phone-w) * -0.007);
    top: 27%;
    height: 12%;
  }

  .phone-screen {
    position: relative;
    overflow: hidden;
    /* Real 9:19.5 body, so the device reads correctly whatever the screen holds. */
    aspect-ratio: 9 / 19.5;
    /* The black ring around the panel. */
    border-radius: calc(var(--phone-w) * 0.128);
    background: var(--color-ink-950);
    box-shadow: 0 0 0 1px var(--color-ink-950), inset 0 0 0 1px rgb(255 255 255 / 0.07);
  }

  .phone-island {
    position: absolute;
    z-index: 2;
    top: calc(var(--phone-w) * 0.045);
    left: 50%;
    translate: -50% 0;
    width: calc(var(--phone-w) * 0.3);
    height: calc(var(--phone-w) * 0.085);
    border-radius: 999px;
    background: #000;
  }

  .phone-ui {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--color-paper);
  }

  /* Kept faint on purpose: this site is flat, not glossy. */
  .phone-glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      118deg,
      rgb(255 255 255 / 0.16),
      rgb(255 255 255 / 0.05) 26%,
      rgb(255 255 255 / 0) 44%
    );
  }
</style>